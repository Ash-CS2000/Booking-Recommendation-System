# Copy this file to .env and fill in real values to turn on semantic search.
# Until these are set, /api/listings silently uses keyword search only —
# nothing breaks, semantic search just doesn't activate.

# --- The local embedding service (web/embedding-service) ---
EMBEDDING_SERVICE_URL=http://localhost:5001

# --- Databricks ---
# Your workspace URL, e.g. https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_HOST=
# A personal access token: workspace top-right avatar -> Settings ->
# Developer -> Access tokens -> Generate new token. Treat like a password.
DATABRICKS_TOKEN=
# The full 3-part index name printed by embed_to_vector_search.ipynb as
# INDEX_NAME, e.g. main.booking_system.documents_index
DATABRICKS_VS_INDEX=
